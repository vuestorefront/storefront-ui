{
  "name": "@storefront-ui/preview-nuxt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port=3001",
    "build": "PROD=true nuxt build",
    "build:nuxt": "yarn build",
    "serve": "node .output/server/index.mjs",
    "lint": "yarn eslint --max-warnings 0 && yarn prettier --check",
    "lint:fix": "yarn eslint --fix && yarn prettier --write",
    "eslint": "eslint \"**/*.{js,ts,vue}\"",
    "prettier": "prettier --log-level warn --no-error-on-unmatched-pattern \"**/*.{js,ts,vue}\""
  },
  "devDependencies": {
    "@frsource/autoresize-textarea": "^2.0.87",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@storefront-ui/eslint-config": "^0.0.0",
    "@storefront-ui/example-style": "^0.0.0",
    "@storefront-ui/nuxt": "^2.5.4",
    "@storefront-ui/shared": "^2.5.1",
    "@storefront-ui/tw-plugin-peer-next": "^2.3.3",
    "@storefront-ui/typography": "^2.6.1",
    "@storefront-ui/vue": "^2.6.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^12.8.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.34.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "nuxt": "^3.14.159",
    "postcss": "^8.4.21",
    "prettier": "^3.0.0",
    "sass": "^1.77.8",
    "sass-loader": "^14.2.1",
    "tailwindcss": "^4.1.11"
  },
  "dependencies": {
    "@storefront-ui/preview-shared": "^0.0.0",
    "lodash-es": "^4.17.21"
  }
